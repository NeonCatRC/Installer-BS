# Installer-BS recipe: wrap ANY local AppImage into a .bs — no download.
# Handy on EOL distros where curl can't reach modern TLS (expired CA bundle) but
# a browser downloads fine, or simply for offline/local files.
#
# Usage (download the AppImage with your browser first, then):
#   APP_FILE=~/krita-4.2.9-x86_64.appimage APP_NAME=krita-old APP_VERSION=4.2.9 \
#     APP_PRETTY="Krita (4.2.9)" APP_CATEGORIES="Graphics;2DGraphics;" \
#     APP_MIME="application/x-krita;" \
#     ./bs make examples/appimage/recipe
#
# NB: the env vars are APP_* — NOT BS_*, which collide with bs's own readonly
# globals (BS_NAME/BS_VERSION) and would be ignored.

name="${APP_NAME:-app}"
version="${APP_VERSION:-1.0}"
arch=x86_64
os=linux
exec=bs-run
pretty_name="${APP_PRETTY:-$name}"
comment="${APP_COMMENT:-Repacked AppImage}"
categories="${APP_CATEGORIES:-Utility;}"
mime_types="${APP_MIME:-}"       # optional MimeType= for the .desktop
terminal=false
bundle_libs=false
min_glibc="${APP_MIN_GLIBC:-}"   # optional override; bs build auto-detects from the ELFs otherwise

prepare() {
	[[ -n "${APP_FILE:-}" && -f "${APP_FILE:-}" ]] || {
		ui::error "set APP_FILE=/path/to/file.appimage (an existing file)"; return 1; }
	bs_appimage_extract "$APP_FILE" "$pkgdir" || return 1
	[[ -e "$pkgdir/AppRun" ]] || { ui::error "extracted AppImage has no AppRun"; return 1; }

	# When an AppImage runs normally its runtime FUSE-mounts it and exports APPDIR
	# (and, for python-bundled apps, the interpreter finds its stdlib relative to
	# the mount). We run it EXTRACTED, so set those up ourselves. Without this,
	# Krita's bundled Python fails with "No module named 'encodings'".
	cat > "$pkgdir/bs-run" <<'WRAP'
#!/usr/bin/env bash
root="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
export APPDIR="$root"
# Relocate a bundled Python interpreter, if present (usr/lib/python3.X).
if compgen -G "$root/usr/lib/python3.*" >/dev/null 2>&1; then
	export PYTHONHOME="$root/usr"
fi
exec "$root/AppRun" "$@"
WRAP
	chmod +x "$pkgdir/bs-run"

	# Auto-pick an icon: prefer a hicolor 256x256 from the AppImage's own theme
	# tree (the size is known from the dir name); fall back to a root-level png
	# (AppImage convention; size unknown, registered as 256 — fine for menus).
	local ic
	ic="$(find "$pkgdir/usr/share/icons" -path '*hicolor/256x256/apps/*.png' 2>/dev/null | head -1 || true)"
	[[ -n "$ic" ]] || ic="$(compgen -G "$pkgdir/*.png" 2>/dev/null | head -1 || true)"
	[[ -n "$ic" ]] && { icon="${ic#"$pkgdir/"}"; icon_size=256; }
}
