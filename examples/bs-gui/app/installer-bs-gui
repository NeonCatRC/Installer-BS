#!/usr/bin/env bash
# Installer-BS — a small, honest front-end for the `bs` CLI.
#
# Autonomous by design: the core UI is a pure-bash framed text menu (zero
# dependencies — runs anywhere bash does: Ubuntu 16.04, BSD, a rescue shell).
# If the host has zenity AND a display, we use a windowed GUI instead. Either
# way it is optional sugar over a fully scriptable CLI, and it never shows
# nothing: launched by double-click without zenity, it re-opens in a terminal.
#
# The deliberate counter to the original's hostile terminal (Museum hall 6).
# We bundle the `bs` runtime, not a GUI toolkit. All interactive I/O of the TUI
# goes through /dev/tty, so menus survive being called inside $(...).
set -uo pipefail

SELF="$(readlink -f -- "$0" 2>/dev/null || echo "$0")"
APP="$(cd -- "$(dirname -- "$SELF")" && pwd)"
BS="$APP/bs-runtime/bs"
TITLE="Installer-BS"

# --- i18n (tiny: ru when $LANG starts with ru, else en) ---------------------
case "${LANG:-}" in ru*|RU*) L=ru ;; *) L=en ;; esac
t() {
	case "$L:$1" in
		ru:subtitle)       echo "менеджер пакетов" ;;
		ru:menu_installed) echo "Установленные пакеты" ;;
		ru:menu_open)      echo "Открыть .bs файл" ;;
		ru:menu_about)     echo "О программе" ;;
		ru:menu_quit)      echo "Выход" ;;
		ru:pick_action)    echo "Что сделать?" ;;
		ru:run)            echo "Запустить" ;;
		ru:info)           echo "Информация" ;;
		ru:uninstall)      echo "Удалить" ;;
		ru:install)        echo "Установить" ;;
		ru:verify)         echo "Проверить подпись" ;;
		ru:back)           echo "Назад" ;;
		ru:none_installed) echo "Через Installer-BS пока ничего не установлено. Откройте .bs-файл, чтобы установить." ;;
		ru:confirm_rm)     echo "Удалить пакет" ;;
		ru:ask_path)       echo "Путь к .bs файлу (Tab — дополнение, пусто — назад):" ;;
		ru:not_found)      echo "Файл не найден:" ;;
		ru:enter_cont)     echo "Enter — продолжить" ;;
		ru:choose)         echo "Выбор" ;;
		ru:launched)       echo "Запущено." ;;
		ru:about_text)     echo "Installer-BS — дружелюбная обёртка над CLI «bs». Это окно опционально: всё, что здесь есть, — одна команда bs. Ядро интерфейса — чистый bash (ноль зависимостей), а если в системе есть zenity, рисуем настоящее окно. GTK ради меню мы не вкладываем и, в отличие от оригинала, не двигаем твой терминал. BS = Bundled Software / Bash Script / BullShit — и всё это честно." ;;
		*:subtitle)        echo "package manager" ;;
		*:menu_installed)  echo "Installed packages" ;;
		*:menu_open)       echo "Open a .bs file" ;;
		*:menu_about)      echo "About" ;;
		*:menu_quit)       echo "Quit" ;;
		*:pick_action)     echo "What to do?" ;;
		*:run)             echo "Run" ;;
		*:info)            echo "Info" ;;
		*:uninstall)       echo "Uninstall" ;;
		*:install)         echo "Install" ;;
		*:verify)          echo "Verify signature" ;;
		*:back)            echo "Back" ;;
		*:none_installed)  echo "Nothing installed via Installer-BS yet. Open a .bs file to install one." ;;
		*:confirm_rm)      echo "Remove package" ;;
		*:ask_path)        echo "Path to a .bs file (Tab completes, empty = back):" ;;
		*:not_found)       echo "File not found:" ;;
		*:enter_cont)      echo "Press Enter to continue" ;;
		*:choose)          echo "Choice" ;;
		*:launched)        echo "Launched." ;;
		*:about_text)      echo "Installer-BS is a friendly wrapper around the bs CLI. This window is optional: everything here is one bs command away. The UI core is pure bash (zero dependencies); if zenity is present we draw a real window. We bundle no GTK for a menu and, unlike the original, never move your terminal. BS = Bundled Software / Bash Script / BullShit — all true." ;;
		*) echo "$1" ;;
	esac
}

# --- backend selection ------------------------------------------------------
BACKEND=tui
if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
	BACKEND=zenity
elif [[ ! -t 0 || ! -t 1 ]]; then
	# No zenity and no terminal (double-clicked): re-open in a terminal so we
	# never just vanish.
	for term in x-terminal-emulator gnome-terminal konsole xfce4-terminal mate-terminal xterm; do
		command -v "$term" >/dev/null 2>&1 || continue
		case "$term" in
			gnome-terminal) exec "$term" -- "$SELF" ;;
			*)              exec "$term" -e "$SELF" ;;
		esac
	done
	command -v notify-send >/dev/null 2>&1 && notify-send "$TITLE" "Run me from a terminal (no zenity / no terminal found)."
	command -v xmessage    >/dev/null 2>&1 && xmessage -center "$TITLE: run me from a terminal."
	exit 1
fi

# --- TUI palette (only on a real terminal, honour NO_COLOR) ------------------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
	c_b=$'\e[1m'; c_d=$'\e[2m'; c_g=$'\e[32m'; c_y=$'\e[33m'; c_c=$'\e[36m'; c_r=$'\e[0m'
else c_b=''; c_d=''; c_g=''; c_y=''; c_c=''; c_r=''; fi

zen() { zenity "$@" 2>/dev/null; }

# --- TUI drawing (all to /dev/tty; widths use bytes, so chrome is borderless
#     on the right to stay correct with multibyte UTF-8 labels) ---------------
_cols() { local c=80; command -v tput >/dev/null 2>&1 && c="$(tput cols 2>/dev/null)"; [[ "$c" =~ ^[0-9]+$ ]] && (( c>=24 )) || c=80; (( c>92 )) && c=92; printf '%s' "$c"; }
_rule() { local n="$1" s=''; while (( n-- > 0 )); do s+='─'; done; printf '%s' "$s"; }
_header() { # $1 = subtitle
	local w; w="$(_cols)"
	{
		printf '\033[H\033[2J'
		printf '%s%s%s\n' "$c_g" "$(_rule "$w")" "$c_r"
		printf '  %s%s%s %s·%s %s%s%s\n' "$c_b$c_c" "$TITLE" "$c_r" "$c_d" "$c_r" "$c_b" "${1:-$(t subtitle)}" "$c_r"
		printf '%s%s%s\n\n' "$c_g" "$(_rule "$w")" "$c_r"
	} >/dev/tty
}

# --- UI primitives: one logic path, two backends ----------------------------

# ui_menu SUBTITLE LABEL...  -> prints the chosen LABEL on stdout (empty = back)
ui_menu() {
	local sub="$1"; shift
	if [[ "$BACKEND" == zenity ]]; then
		zen --list --title="$TITLE — $sub" --text="$(t pick_action)" --width=460 --height=360 \
			--hide-header --column=action "$@"
		return
	fi
	local i opt reply
	while true; do
		_header "$sub"
		{ i=1; for opt in "$@"; do printf '    %s▸%s %s%2d%s  %s\n' "$c_g" "$c_r" "$c_b" "$i" "$c_r" "$opt"; i=$((i+1)); done
		  printf '\n  %s%s [1-%d, %s — назад]:%s ' "$c_d" "$(t choose)" "$#" "Enter" "$c_r"; } >/dev/tty
		read -r reply </dev/tty || return 1
		[[ -z "$reply" ]] && return 1
		[[ "$reply" == q || "$reply" == Q ]] && return 1
		if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= $# )); then
			printf '%s\n' "${!reply}"; return 0
		fi
	done
}

# ui_confirm MESSAGE -> exit status
ui_confirm() {
	if [[ "$BACKEND" == zenity ]]; then zen --question --title="$TITLE" --text="$1"; return; fi
	local reply
	printf '\n  %s%s%s [y/N] ' "$c_y" "$1" "$c_r" >/dev/tty
	read -r reply </dev/tty || return 1
	[[ "$reply" == y || "$reply" == yes || "$reply" == д || "$reply" == да ]]
}

# ui_message SUBTITLE   (prose on stdin) — a notice that WRAPS
ui_message() {
	local body; body="$(cat)"
	if [[ "$BACKEND" == zenity ]]; then
		zen --info --title="$TITLE — $1" --width=480 --text="$body"; return
	fi
	local w; w="$(_cols)"
	_header "$1"
	{ printf '%s\n' "$body" | fold -s -w $(( w - 4 )) | sed 's/^/  /'
	  printf '\n  %s%s…%s ' "$c_d" "$(t enter_cont)" "$c_r"; } >/dev/tty
	read -r _ </dev/tty || true
}

# ui_run_log SUBTITLE cmd...  -> run cmd, show its combined output (monospace)
ui_run_log() {
	local sub="$1"; shift
	if [[ "$BACKEND" == zenity ]]; then
		{ "$@" 2>&1; printf '\n[exit %s]\n' "$?"; } \
			| zen --text-info --title="$TITLE — $sub" --width=740 --height=500 --auto-scroll --no-wrap
		return
	fi
	local ec
	_header "$sub"
	"$@" >/dev/tty 2>&1; ec=$?
	{ printf '\n  %s[exit %s]%s   %s%s…%s ' "$c_d" "$ec" "$c_r" "$c_d" "$(t enter_cont)" "$c_r"; } >/dev/tty
	read -r _ </dev/tty || true
}

# ui_pick_file -> prints a path on stdout (empty = back)
ui_pick_file() {
	if [[ "$BACKEND" == zenity ]]; then
		zen --file-selection --title="$TITLE — $(t menu_open)" --file-filter="*.bs" --file-filter="*"; return
	fi
	local p
	_header "$(t menu_open)"
	printf '  %s%s%s\n  > ' "$c_b" "$(t ask_path)" "$c_r" >/dev/tty
	read -r -e p </dev/tty || return 1
	[[ -n "$p" ]] || return 1
	p="${p/#\~/$HOME}"
	[[ -f "$p" ]] || { printf '%s\n' "$(t not_found) $p" | ui_message "$(t menu_open)"; return 1; }
	printf '%s\n' "$p"
}

# ui_pick_pkg -> prints "name|scope" of a chosen installed package (empty = back)
ui_pick_pkg() {
	local -a names=() vers=() scopes=() labels=()
	local line name ver scope k
	while IFS= read -r line; do
		[[ "$line" =~ ^[[:space:]]*:: ]] && continue
		read -r name ver scope _ <<< "$line"
		[[ "$scope" == user || "$scope" == system ]] || continue
		names+=("$name"); vers+=("$ver"); scopes+=("$scope")
		labels+=("$(printf '%-22s %-10s (%s)' "$name" "$ver" "$scope")")
	done < <("$BS" list 2>/dev/null)

	((${#names[@]})) || { printf '%s\n' "$(t none_installed)" | ui_message "$(t menu_installed)"; return 1; }

	if [[ "$BACKEND" == zenity ]]; then
		local sel; local -a rows=()
		for k in "${!names[@]}"; do rows+=("${names[$k]}" "${vers[$k]}" "${scopes[$k]}"); done
		sel="$(zen --list --title="$TITLE — $(t menu_installed)" --width=560 --height=420 \
			--print-column=1,3 --separator='|' --column=Name --column=Version --column=Scope "${rows[@]}")" || return 1
		[[ -n "$sel" ]] && printf '%s\n' "$sel"
		return 0
	fi
	local chosen idx; chosen="$(ui_menu "$(t menu_installed)" "${labels[@]}")" || return 1
	for idx in "${!labels[@]}"; do
		[[ "${labels[$idx]}" == "$chosen" ]] && { printf '%s|%s\n' "${names[$idx]}" "${scopes[$idx]}"; return 0; }
	done
	return 1
}

# --- flows ------------------------------------------------------------------
installed_flow() {
	local sel name scope act bindir
	sel="$(ui_pick_pkg)" || return
	[[ -n "$sel" ]] || return
	name="${sel%%|*}"; scope="${sel##*|}"
	local -a sysflag=(); [[ "$scope" == system ]] && sysflag=(--system)
	bindir="$HOME/.local/bin"; [[ "$scope" == system ]] && bindir="/usr/local/bin"
	act="$(ui_menu "$name ($scope)" "$(t run)" "$(t info)" "$(t uninstall)" "$(t back)")" || return
	case "$act" in
		"$(t run)")       setsid "$bindir/$name" >/dev/null 2>&1 & printf '%s\n' "$(t launched)" | ui_message "$name" ;;
		"$(t info)")      ui_run_log "$(t info): $name" "$BS" info "$name" ;;
		"$(t uninstall)")
			ui_confirm "$(t confirm_rm) \"$name\" ($scope)?" || return
			ui_run_log "$(t uninstall): $name" "$BS" --yes uninstall "$name" "${sysflag[@]}" ;;
	esac
}

open_flow() {
	local f act
	f="$(ui_pick_file)" || return
	[[ -n "$f" ]] || return
	act="$(ui_menu "$(basename -- "$f")" "$(t run)" "$(t install)" "$(t verify)" "$(t info)" "$(t back)")" || return
	case "$act" in
		"$(t run)")     setsid bash -- "$f" >/dev/null 2>&1 & printf '%s\n' "$(t launched)" | ui_message "$(basename -- "$f")" ;;
		"$(t install)") ui_run_log "$(t install)" bash -- "$f" --install ;;
		"$(t verify)")  ui_run_log "$(t verify)" "$BS" verify "$f" ;;
		"$(t info)")    ui_run_log "$(t info)" bash -- "$f" --info ;;
	esac
}

about() { { printf '%s\n\n' "$(t about_text)"; "$BS" version 2>/dev/null | head -1; } | ui_message "$(t menu_about)"; }

# --- main menu loop ---------------------------------------------------------
while true; do
	choice="$(ui_menu "$(t subtitle)" "$(t menu_installed)" "$(t menu_open)" "$(t menu_about)" "$(t menu_quit)")" || break
	case "$choice" in
		"$(t menu_installed)") installed_flow ;;
		"$(t menu_open)")      open_flow ;;
		"$(t menu_about)")     about ;;
		*) break ;;
	esac
done
if [[ "$BACKEND" == tui ]]; then printf '\033[H\033[2J' >/dev/tty 2>/dev/null || true; fi
