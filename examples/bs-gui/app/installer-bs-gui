#!/usr/bin/env bash
# Installer-BS — a small, honest front-end for the `bs` CLI.
#
# Autonomous by design: the core UI is a pure-bash text menu (zero dependencies,
# works anywhere bash does — Ubuntu 16.04, BSD, a rescue shell). If the host has
# zenity AND a display, we use it for a nicer windowed GUI instead. Either way it
# is optional sugar over a fully scriptable CLI, and it never shows you nothing:
# launched by double-click without zenity, it re-opens itself in a terminal.
#
# This is the deliberate counter to the original's hostile terminal (Museum hall 6:
# forced window resize, read-pause after every step, Terminal=true). We bundle the
# `bs` runtime, not a GUI toolkit — drawing a list box justifies neither 80 MB of
# GTK nor a hard dependency on the host's dialog tools.
set -uo pipefail

SELF="$(readlink -f -- "$0" 2>/dev/null || echo "$0")"
APP="$(cd -- "$(dirname -- "$SELF")" && pwd)"
BS="$APP/bs-runtime/bs"
TITLE="Installer-BS"

# --- i18n (tiny: ru when $LANG starts with ru, else en) ---------------------
case "${LANG:-}" in ru*|RU*) L=ru ;; *) L=en ;; esac
t() {
	case "$L:$1" in
		ru:menu_installed) echo "Установленные пакеты" ;;
		ru:menu_open)      echo "Открыть .bs файл" ;;
		ru:menu_about)     echo "О программе" ;;
		ru:menu_quit)      echo "Выход" ;;
		ru:pick_action)    echo "Что сделать?" ;;
		ru:run)            echo "Запустить" ;;
		ru:info)           echo "Информация" ;;
		ru:uninstall)      echo "Удалить" ;;
		ru:install)        echo "Установить" ;;
		ru:verify)         echo "Проверить подпись" ;;
		ru:back)           echo "Назад" ;;
		ru:none_installed) echo "Ничего не установлено через Installer-BS." ;;
		ru:confirm_rm)     echo "Удалить пакет" ;;
		ru:ask_path)       echo "Путь к .bs файлу" ;;
		ru:not_found)      echo "Файл не найден" ;;
		ru:enter_cont)     echo "Enter — продолжить…" ;;
		ru:choose)         echo "Выбор (число, пусто — назад)" ;;
		ru:about_text)     echo "Installer-BS — обёртка над bs. Это окно опционально: всё здесь — одна команда bs. Рисуем системным zenity или текстом; GTK ради меню не вкладываем и терминал, в отличие от оригинала, не двигаем." ;;
		*:menu_installed)  echo "Installed packages" ;;
		*:menu_open)       echo "Open a .bs file" ;;
		*:menu_about)      echo "About" ;;
		*:menu_quit)       echo "Quit" ;;
		*:pick_action)     echo "What to do?" ;;
		*:run)             echo "Run" ;;
		*:info)            echo "Info" ;;
		*:uninstall)       echo "Uninstall" ;;
		*:install)         echo "Install" ;;
		*:verify)          echo "Verify signature" ;;
		*:back)            echo "Back" ;;
		*:none_installed)  echo "Nothing installed via Installer-BS yet." ;;
		*:confirm_rm)      echo "Remove package" ;;
		*:ask_path)        echo "Path to a .bs file" ;;
		*:not_found)       echo "File not found" ;;
		*:enter_cont)      echo "Press Enter to continue…" ;;
		*:choose)          echo "Choose (number, empty = back)" ;;
		*:about_text)      echo "Installer-BS — a front-end for bs. This window is optional: everything here is one bs command away. We draw with your zenity or as text, bundle no GTK for a menu, and (unlike the original) don't move your terminal." ;;
		*) echo "$1" ;;
	esac
}

# --- backend selection ------------------------------------------------------
BACKEND=tui
if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
	BACKEND=zenity
elif [[ ! -t 0 || ! -t 1 ]]; then
	# No zenity and no terminal (e.g. double-clicked): re-open in a terminal so we
	# never just vanish. Best effort across the common emulators.
	for term in x-terminal-emulator gnome-terminal konsole xfce4-terminal mate-terminal xterm; do
		command -v "$term" >/dev/null 2>&1 || continue
		case "$term" in
			gnome-terminal) exec "$term" -- "$SELF" ;;
			*)              exec "$term" -e "$SELF" ;;
		esac
	done
	command -v notify-send >/dev/null 2>&1 && notify-send "$TITLE" "Run me from a terminal (no zenity, no terminal found)."
	command -v xmessage    >/dev/null 2>&1 && xmessage -center "$TITLE: run me from a terminal."
	exit 1
fi

# --- TUI colours (only on a real terminal, honour NO_COLOR) ------------------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
	c_b=$'\e[1m'; c_d=$'\e[2m'; c_g=$'\e[32m'; c_y=$'\e[33m'; c_r=$'\e[0m'
else c_b=''; c_d=''; c_g=''; c_y=''; c_r=''; fi
_clear() { printf '\033[H\033[2J'; }

zen() { zenity "$@" 2>/dev/null; }

# --- UI primitives: one logic path, two backends ----------------------------

# ui_menu TITLE LABEL...  -> prints the chosen LABEL (empty = cancel/back)
ui_menu() {
	local title="$1"; shift
	if [[ "$BACKEND" == zenity ]]; then
		zen --list --title="$TITLE — $title" --width=460 --height=340 --hide-header --column=action "$@"
		return
	fi
	local i=1 opt reply
	# Visible menu chrome goes to stderr: this function is called inside $(...),
	# so stdout is reserved for the chosen label (the menu must not land in it).
	{
		_clear; printf '%s%s — %s%s\n\n' "$c_b" "$TITLE" "$title" "$c_r"
		for opt in "$@"; do printf '  %s%2d%s) %s\n' "$c_g" "$i" "$c_r" "$opt"; i=$((i+1)); done
		printf '\n%s%s:%s ' "$c_d" "$(t choose)" "$c_r"
	} >&2
	read -r reply || return 1
	[[ "$reply" =~ ^[0-9]+$ ]] || return 1
	(( reply >= 1 && reply <= $# )) || return 1
	printf '%s\n' "${!reply}"
}

# ui_confirm MESSAGE -> exit status
ui_confirm() {
	if [[ "$BACKEND" == zenity ]]; then zen --question --title="$TITLE" --text="$1"; return; fi
	local reply; printf '%s%s [y/N]%s ' "$c_y" "$1" "$c_r" >&2; read -r reply || return 1
	[[ "$reply" == y || "$reply" == yes || "$reply" == д || "$reply" == да ]]
}

# ui_run_log TITLE cmd...  -> run cmd, show its combined output
ui_run_log() {
	local title="$1"; shift
	if [[ "$BACKEND" == zenity ]]; then
		{ "$@" 2>&1; printf '\n[exit %s]\n' "$?"; } \
			| zen --text-info --title="$TITLE — $title" --width=720 --height=480 --auto-scroll --no-wrap
		return
	fi
	_clear; printf '%s%s — %s%s\n\n' "$c_b" "$TITLE" "$title" "$c_r"
	"$@" 2>&1; printf '\n%s[exit %s]%s\n' "$c_d" "$?" "$c_r"
	printf '\n%s%s%s ' "$c_d" "$(t enter_cont)" "$c_r"; read -r _ || true
}

# ui_show TITLE   (text on stdin)
ui_show() {
	if [[ "$BACKEND" == zenity ]]; then
		zen --text-info --title="$TITLE — $1" --width=620 --height=380 --no-wrap; return
	fi
	_clear; printf '%s%s — %s%s\n\n' "$c_b" "$TITLE" "$1" "$c_r"; cat
	printf '\n%s%s%s ' "$c_d" "$(t enter_cont)" "$c_r"; read -r _ || true
}

# ui_pick_file -> prints a path (empty = cancel)
ui_pick_file() {
	if [[ "$BACKEND" == zenity ]]; then
		zen --file-selection --title="$TITLE — $(t menu_open)" --file-filter="*.bs" --file-filter="*"; return
	fi
	local p; { _clear; printf '%s%s%s ' "$c_b" "$(t ask_path):" "$c_r"; } >&2
	read -r -e p || return 1
	[[ -n "$p" ]] || return 1
	p="${p/#\~/$HOME}"
	[[ -f "$p" ]] || { printf '%s%s%s\n' "$c_y" "$(t not_found): $p" "$c_r" >&2; sleep 1; return 1; }
	printf '%s\n' "$p"
}

# ui_pick_pkg -> prints "name|scope" of a chosen installed package (empty = back)
ui_pick_pkg() {
	local -a names=() vers=() scopes=() labels=()
	local line name ver scope
	while IFS= read -r line; do
		[[ "$line" =~ ^[[:space:]]*:: ]] && continue   # skip ui::info lines
		read -r name ver scope _ <<< "$line"
		[[ "$scope" == user || "$scope" == system ]] || continue
		names+=("$name"); vers+=("$ver"); scopes+=("$scope")
		labels+=("$name $ver ($scope)")
	done < <("$BS" list 2>/dev/null)

	((${#names[@]})) || { printf '%s\n' "$(t none_installed)" | ui_show "$(t menu_installed)"; return 1; }

	if [[ "$BACKEND" == zenity ]]; then
		local sel
		local -a rows=(); local k
		for k in "${!names[@]}"; do rows+=("${names[$k]}" "${vers[$k]}" "${scopes[$k]}"); done
		sel="$(zen --list --title="$TITLE — $(t menu_installed)" --width=560 --height=420 \
			--print-column=1,3 --separator='|' --column=Name --column=Version --column=Scope "${rows[@]}")" || return 1
		[[ -n "$sel" ]] && printf '%s\n' "$sel"
		return 0
	fi
	local chosen; chosen="$(ui_menu "$(t menu_installed)" "${labels[@]}")" || return 1
	local idx
	for idx in "${!labels[@]}"; do
		[[ "${labels[$idx]}" == "$chosen" ]] && { printf '%s|%s\n' "${names[$idx]}" "${scopes[$idx]}"; return 0; }
	done
	return 1
}

# --- flows ------------------------------------------------------------------
installed_flow() {
	local sel name scope act bindir
	sel="$(ui_pick_pkg)" || return
	[[ -n "$sel" ]] || return
	name="${sel%%|*}"; scope="${sel##*|}"
	local -a sysflag=(); [[ "$scope" == system ]] && sysflag=(--system)
	bindir="$HOME/.local/bin"; [[ "$scope" == system ]] && bindir="/usr/local/bin"
	act="$(ui_menu "$name — $(t pick_action)" "$(t run)" "$(t info)" "$(t uninstall)" "$(t back)")" || return
	case "$act" in
		"$(t run)")       setsid "$bindir/$name" >/dev/null 2>&1 & ;;
		"$(t info)")      ui_run_log "$(t info): $name" "$BS" info "$name" ;;
		"$(t uninstall)")
			ui_confirm "$(t confirm_rm) \"$name\" ($scope)?" || return
			ui_run_log "$(t uninstall): $name" "$BS" --yes uninstall "$name" "${sysflag[@]}" ;;
	esac
}

open_flow() {
	local f act
	f="$(ui_pick_file)" || return
	[[ -n "$f" ]] || return
	act="$(ui_menu "$(basename -- "$f") — $(t pick_action)" "$(t run)" "$(t install)" "$(t verify)" "$(t info)" "$(t back)")" || return
	case "$act" in
		"$(t run)")     setsid bash -- "$f" >/dev/null 2>&1 & ;;
		"$(t install)") ui_run_log "$(t install)" bash -- "$f" --install ;;
		"$(t verify)")  ui_run_log "$(t verify)" "$BS" verify "$f" ;;
		"$(t info)")    ui_run_log "$(t info)" bash -- "$f" --info ;;
	esac
}

about() { { printf '%s\n\n' "$(t about_text)"; "$BS" version 2>/dev/null | head -1; } | ui_show "$(t menu_about)"; }

# --- main menu loop ---------------------------------------------------------
while true; do
	choice="$(ui_menu "" "$(t menu_installed)" "$(t menu_open)" "$(t menu_about)" "$(t menu_quit)")" || break
	case "$choice" in
		"$(t menu_installed)") installed_flow ;;
		"$(t menu_open)")      open_flow ;;
		"$(t menu_about)")     about ;;
		*) break ;;
	esac
done
if [[ "$BACKEND" == tui ]]; then _clear; fi
